<!DOCTYPE html>
<html>

<head>

    <title>Donate Food</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

<div class="auth-container">

    <div class="left-panel">

        <div class="left-content">

            <h1>
                Donate Food
            </h1>

            <p>
                Your small contribution can help feed many people.
                RescueMeals helps reduce food wastage through smart food distribution.
            </p>

        </div>

    </div>

    <div class="right-panel">

        <div class="form-box">

            <h1 class="form-title">
                Add Donation
            </h1>

            <p class="form-subtitle">
                Fill donation details
            </p>

            <form
                action="/donate"
                method="POST"
                enctype="multipart/form-data">

                <input
                    type="text"
                    name="foodName"
                    class="form-control"
                    placeholder="Food Name"
                    required>

                <input
                    type="text"
                    name="quantity"
                    class="form-control"
                    placeholder="Quantity"
                    required>

                <input
                    type="text"
                    name="location"
                    class="form-control"
                    placeholder="Pickup Location"
                    required>

                <input
                    type="text"
                    name="contact"
                    class="form-control"
                    placeholder="Contact Number"
                    required>

                <input
                    type="file"
                    name="image"
                    class="form-control"
                    required>

                <button class="main-btn">
                    Donate Food
                </button>

            </form>

        </div>

    </div>

</div>

</body>
</html>