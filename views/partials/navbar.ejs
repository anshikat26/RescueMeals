<!-- Navigation Bar - RescueMeals -->
<link rel="stylesheet" href="/css/navbar.css">

<nav class="navbar" id="navbar">
    <div class="navbar-container">
        <a href="/" class="navbar-logo">
            <% if (typeof settings !== 'undefined' && settings.logo_url) { %>
                <img src="<%= settings.logo_url %>" alt="<%= settings.website_name || 'RescueMeals' %>" class="navbar-logo-img">
            <% } else { %>
                <i class="fas fa-leaf"></i>
            <% } %>
            <%= typeof settings !== 'undefined' ? (settings.website_name || 'RescueMeals') : 'RescueMeals' %>
        </a>

        <ul class="navbar-menu">
            <li><a href="#home">Home</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#features">Features</a></li>
            <li><a href="#how-it-works">How It Works</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>

        <div class="navbar-auth">
            <a href="/login" class="navbar-btn navbar-login">Login</a>
            <a href="/signup" class="navbar-btn navbar-signup">Register</a>
        </div>

        <div class="navbar-toggle" id="navbarToggle">
            <span></span>
            <span></span>
            <span></span>
        </div>
    </div>
</nav>

<!-- Mobile Menu -->
<div class="navbar-mobile-menu" id="navbarMobileMenu">
    <ul>
        <li><a href="#home">Home</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#features">Features</a></li>
        <li><a href="#how-it-works">How It Works</a></li>
        <li><a href="#contact">Contact</a></li>
    </ul>
    <div class="navbar-mobile-auth">
        <a href="/login" class="navbar-btn navbar-login">Login</a>
        <a href="/signup" class="navbar-btn navbar-signup">Register</a>
    </div>
</div>

<script>
    // Navbar scroll effect
    window.addEventListener('scroll', function() {
        const navbar = document.getElementById('navbar');
        if (window.scrollY > 50) {
            navbar.classList.add('scrolled');
        } else {
            navbar.classList.remove('scrolled');
        }
    });

    // Mobile menu toggle
    const navbarToggle = document.getElementById('navbarToggle');
    const navbarMobileMenu = document.getElementById('navbarMobileMenu');

    navbarToggle.addEventListener('click', function() {
        navbarToggle.classList.toggle('active');
        navbarMobileMenu.classList.toggle('active');
    });

    // Close mobile menu when clicking a link
    const mobileLinks = navbarMobileMenu.querySelectorAll('a');
    mobileLinks.forEach(link => {
        link.addEventListener('click', function() {
            navbarToggle.classList.remove('active');
            navbarMobileMenu.classList.remove('active');
        });
    });

    // Smooth scrolling for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function(e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if (target) {
                target.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });
            }
        });
    });
</script>
