<!-- Footer - RescueMeals Professional Design -->
<link rel="stylesheet" href="/css/footer.css">

<footer class="footer" id="footer">
    <div class="footer-container">
        <!-- Top Newsletter / Impact Callout Bar -->
        <div class="footer-newsletter-card">
            <div class="newsletter-text">
                <i class="fas fa-paper-plane"></i>
                <div>
                    <h4>Subscribe to Monthly Impact Reports</h4>
                    <p>Join 15,000+ supporters tracking zero-waste meals and ESG metrics across India.</p>
                </div>
            </div>
            <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Thank you for subscribing to RescueMeals Impact Reports!');">
                <input type="email" placeholder="Enter your email address" required class="newsletter-input">
                <button type="submit" class="newsletter-btn"><i class="fas fa-bell"></i> Subscribe</button>
            </form>
        </div>

        <div class="footer-top">
            <!-- Col 1: About & Mission -->
            <div class="footer-about">
                <a href="/" class="footer-logo">
                    <span class="footer-logo-badge"><i class="fas fa-leaf"></i></span>
                    <span class="footer-logo-text"><%= typeof settings !== 'undefined' ? (settings.website_name || 'RescueMeals') : 'RescueMeals' %><span class="logo-dot">.</span></span>
                </a>
                <p>
                    <%= content.footer?.about || 'RescueMeals is India’s leading digital food rescue platform, bridging surplus food from hotels, weddings, and caterers to verified shelters and children in need.' %>
                </p>
                <div class="footer-badges">
                    <span class="footer-badge-chip"><i class="fas fa-shield-check"></i> FSSAI Compliant</span>
                    <span class="footer-badge-chip"><i class="fas fa-certificate"></i> 80G Certified</span>
                </div>
                <div class="footer-social">
                    <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                    <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                    <a href="#" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                    <a href="#" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
                </div>
            </div>

            <!-- Col 2: Quick Links -->
            <div class="footer-links">
                <h4>Quick Navigation</h4>
                <ul>
                    <li><a href="/#home"><i class="fas fa-chevron-right"></i> Home</a></li>
                    <li><a href="/#about"><i class="fas fa-chevron-right"></i> About Us</a></li>
                    <li><a href="/#features"><i class="fas fa-chevron-right"></i> Features</a></li>
                    <li><a href="/gallery"><i class="fas fa-chevron-right"></i> Impact Gallery</a></li>
                    <li><a href="/#testimonials"><i class="fas fa-chevron-right"></i> Stories of Impact</a></li>
                    <li><a href="/#contact"><i class="fas fa-chevron-right"></i> Contact Us</a></li>
                </ul>
            </div>

            <!-- Col 3: Platform Portals -->
            <div class="footer-links">
                <h4>Platform Portals</h4>
                <ul>
                    <li><a href="/login"><i class="fas fa-chevron-right"></i> Donor Portal</a></li>
                    <li><a href="/login"><i class="fas fa-chevron-right"></i> NGO Partner Hub</a></li>
                    <li><a href="/signup"><i class="fas fa-chevron-right"></i> Volunteer Network</a></li>
                    <li><a href="#"><i class="fas fa-chevron-right"></i> Food Safety Policy</a></li>
                    <li><a href="#"><i class="fas fa-chevron-right"></i> Privacy & Terms</a></li>
                </ul>
            </div>

            <!-- Col 4: Official Contact Details -->
            <div class="footer-contact">
                <h4>Contact Us</h4>
                <div class="footer-contact-item">
                    <div class="contact-mini-icon green">
                        <i class="fas fa-location-dot"></i>
                    </div>
                    <span><%= content.footer?.address || 'Maharishi University of Information Technology (MUIT), Lucknow, Uttar Pradesh, India' %></span>
                </div>
                <div class="footer-contact-item">
                    <div class="contact-mini-icon amber">
                        <i class="fas fa-phone-volume"></i>
                    </div>
                    <span><a href="tel:+917232918655" style="color: inherit; text-decoration: none;"><%= content.footer?.phone || '+91 7232918655' %></a></span>
                </div>
                <div class="footer-contact-item">
                    <div class="contact-mini-icon blue">
                        <i class="fas fa-envelope-open-text"></i>
                    </div>
                    <span><a href="mailto:support@rescuemeals.com" style="color: inherit; text-decoration: none;"><%= content.footer?.email || 'support@rescuemeals.com' %></a></span>
                </div>
            </div>
        </div>

        <!-- Footer Bottom Bar -->
        <div class="footer-bottom">
            <p>
                &copy; <%= new Date().getFullYear() %> <%= typeof settings !== 'undefined' ? (settings.website_name || 'RescueMeals') : 'RescueMeals' %>. All rights reserved. Made with <i class="fas fa-heart" style="color: #EF4444;"></i> for Zero Hunger in India.
            </p>
            <div class="footer-bottom-links">
                <a href="#">Privacy Policy</a>
                <span>•</span>
                <a href="#">Terms of Service</a>
                <span>•</span>
                <a href="#">FSSAI Guidelines</a>
            </div>
        </div>
    </div>
</footer>
