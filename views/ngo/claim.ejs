<!DOCTYPE html>
<html>

<head>

    <title>Claim Donation</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

<div class="auth-container">

    <div class="right-panel w-100">

        <div class="form-box">

            <h1 class="form-title">

                Delivery Details

            </h1>

            <p class="form-subtitle">

                Add receiver information

            </p>

            <form
                action="/claim/<%= donation._id %>"
                method="POST">

                <input
                    type="text"
                    name="receiverName"
                    class="form-control"
                    placeholder="Receiver Name"
                    required>

                <input
                    type="text"
                    name="receiverContact"
                    class="form-control"
                    placeholder="Receiver Contact Number"
                    required>

                <input
                    type="text"
                    name="deliveryLocation"
                    class="form-control"
                    placeholder="Delivery Location"
                    required>

                <button class="main-btn">

                    Confirm Claim

                </button>

            </form>

        </div>

    </div>

</div>

</body>
</html>