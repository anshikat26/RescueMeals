<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= settings.seo_title || 'RescueMeals - Waste Food Management System' %></title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>

<body>
    <!-- Navigation Bar -->
    <%- include('partials/navbar') %>

    <!-- Hero Section -->
    <section class="hero-section" id="home">
        <div class="hero-content">
            <h1><%= content.home?.hero?.title || 'RescueMeals' %></h1>
            <p><%= content.home?.hero?.subtitle || 'Reduce Food Waste • Feed Needy People • Support NGOs' %></p>
            <div class="hero-buttons">
                <a href="/signup" class="hero-btn hero-btn-primary">
                    <i class="fas fa-user-plus"></i> Get Started
                </a>
                <a href="/login" class="hero-btn hero-btn-secondary">
                    <i class="fas fa-sign-in-alt"></i> Login
                </a>
            </div>
            <div class="hero-stats">
                <div class="hero-stat-item">
                    <div class="hero-stat-number" data-target="<%= content.home?.hero?.stats?.meals || 5000 %>">0</div>
                    <div class="hero-stat-label"><%= content.home?.hero?.stats?.mealsLabel || 'Meals Saved' %></div>
                </div>
                <div class="hero-stat-item">
                    <div class="hero-stat-number" data-target="<%= content.home?.hero?.stats?.ngos || 200 %>">0</div>
                    <div class="hero-stat-label"><%= content.home?.hero?.stats?.ngosLabel || 'NGO Partners' %></div>
                </div>
                <div class="hero-stat-item">
                    <div class="hero-stat-number" data-target="<%= content.home?.hero?.stats?.volunteers || 150 %>">0</div>
                    <div class="hero-stat-label"><%= content.home?.hero?.stats?.volunteersLabel || 'Volunteers' %></div>
                </div>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section class="about-section" id="about">
        <div class="section-container">
            <div class="section-header">
                <h2><%= content.home?.about?.title || 'About RescueMeals' %></h2>
                <p><%= content.home?.about?.subtitle || 'Connecting food donors with NGOs and volunteers to reduce food wastage and support communities in need.' %></p>
            </div>
            <div class="about-content">
                <div class="about-image">
                    <img src="<%= content.home?.about?.image || 'https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?q=80&w=800' %>" alt="Food Donation">
                </div>
                <div class="about-text">
                    <h3><%= content.home?.about?.heading || 'Making a Difference Together' %></h3>
                    <p><%= content.home?.about?.description1 || 'RescueMeals is a platform dedicated to reducing food waste by connecting restaurants, institutions, and individuals with NGOs and volunteers who can distribute food to those in need.' %></p>
                    <p><%= content.home?.about?.description2 || 'Our mission is to create a sustainable ecosystem where no food goes to waste while ensuring that everyone has access to nutritious meals.' %></p>
                    <div class="about-features">
                        <% const features = content.home?.about?.features || [
                            {icon: 'fa-check-circle', text: 'Reduce Food Waste'},
                            {icon: 'fa-check-circle', text: 'Support Communities'},
                            {icon: 'fa-check-circle', text: 'Easy Donations'},
                            {icon: 'fa-check-circle', text: 'Real-time Tracking'}
                        ]; %>
                        <% features.forEach(feature => { %>
                        <div class="about-feature">
                            <i class="fas <%= feature.icon || 'fa-check-circle' %>"></i>
                            <span><%= feature.text %></span>
                        </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- How It Works Section -->
    <section class="how-it-works-section" id="how-it-works">
        <div class="section-container">
            <div class="section-header">
                <h2>How It Works</h2>
                <p>Simple steps to make a difference in your community</p>
            </div>
            <div class="steps-container">
                <div class="step-card">
                    <div class="step-number">1</div>
                    <div class="step-icon">
                        <i class="fas fa-user-plus"></i>
                    </div>
                    <h3>Register</h3>
                    <p>Sign up as a donor, NGO, or volunteer to start making a difference</p>
                </div>
                <div class="step-card">
                    <div class="step-number">2</div>
                    <div class="step-icon">
                        <i class="fas fa-hand-holding-heart"></i>
                    </div>
                    <h3>Donate Food</h3>
                    <p>List your available food donations with details and images</p>
                </div>
                <div class="step-card">
                    <div class="step-number">3</div>
                    <div class="step-icon">
                        <i class="fas fa-building"></i>
                    </div>
                    <h3>NGO Accepts</h3>
                    <p>NGOs browse and claim donations that match their needs</p>
                </div>
                <div class="step-card">
                    <div class="step-number">4</div>
                    <div class="step-icon">
                        <i class="fas fa-truck"></i>
                    </div>
                    <h3>Food Delivered</h3>
                    <p>Volunteers deliver food to those who need it most</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features-section" id="features">
        <div class="section-container">
            <div class="section-header">
                <h2>Our Features</h2>
                <p>Everything you need to manage food donations efficiently</p>
            </div>
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-bell"></i>
                    </div>
                    <h3>Real-time Notifications</h3>
                    <p>Get instant alerts when new donations are available or when your donation is claimed</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-map-marked-alt"></i>
                    </div>
                    <h3>Location Tracking</h3>
                    <p>Track donations from pickup to delivery with real-time location updates</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <h3>Secure Platform</h3>
                    <p>Your data is protected with industry-standard security measures</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <h3>Impact Analytics</h3>
                    <p>Track your contribution with detailed statistics and reports</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <h3>Community Network</h3>
                    <p>Connect with like-minded individuals and organizations</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-mobile-alt"></i>
                    </div>
                    <h3>Mobile Friendly</h3>
                    <p>Access the platform from any device, anywhere, anytime</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Statistics Section -->
    <section class="statistics-section">
        <div class="section-container">
            <div class="section-header">
                <h2 style="color: white;">Our Impact</h2>
                <p style="color: rgba(255,255,255,0.9);">Making a real difference in communities</p>
            </div>
            <div class="stats-grid">
                <div class="stat-item">
                    <div class="stat-icon">
                        <i class="fas fa-utensils"></i>
                    </div>
                    <div class="stat-number" data-target="15000">0</div>
                    <div class="stat-label">Meals Donated</div>
                </div>
                <div class="stat-item">
                    <div class="stat-icon">
                        <i class="fas fa-building"></i>
                    </div>
                    <div class="stat-number" data-target="250">0</div>
                    <div class="stat-label">Partner NGOs</div>
                </div>
                <div class="stat-item">
                    <div class="stat-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="stat-number" data-target="500">0</div>
                    <div class="stat-label">Active Volunteers</div>
                </div>
                <div class="stat-item">
                    <div class="stat-icon">
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                    <div class="stat-number" data-target="50">0</div>
                    <div class="stat-label">Cities Covered</div>
                </div>
            </div>
        </div>
    </section>

    <!-- NGO/Partner Section -->
    <section class="partners-section">
        <div class="section-container">
            <div class="section-header">
                <h2>Our Partners</h2>
                <p>Trusted organizations working with us</p>
            </div>
            <div class="partners-grid">
                <div class="partner-card">
                    <div class="partner-logo">
                        <i class="fas fa-heart"></i>
                    </div>
                    <h3>Food Bank Foundation</h3>
                    <p>Distributing food since 2010</p>
                </div>
                <div class="partner-card">
                    <div class="partner-logo">
                        <i class="fas fa-hands-helping"></i>
                    </div>
                    <h3>Helping Hands NGO</h3>
                    <p>Serving 50+ communities</p>
                </div>
                <div class="partner-card">
                    <div class="partner-logo">
                        <i class="fas fa-seedling"></i>
                    </div>
                    <h3>Green Earth Initiative</h3>
                    <p>Sustainability focused</p>
                </div>
                <div class="partner-card">
                    <div class="partner-logo">
                        <i class="fas fa-home"></i>
                    </div>
                    <h3>Shelter for All</h3>
                    <p>Supporting homeless</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Testimonials Section -->
    <section class="testimonials-section">
        <div class="section-container">
            <div class="section-header">
                <h2><%= content.home?.testimonials?.title || 'What People Say' %></h2>
                <p><%= content.home?.testimonials?.subtitle || 'Stories from our community members' %></p>
            </div>
            <div class="testimonials-grid">
                <% (testimonials.length > 0 ? testimonials : [
                    {name: 'John Smith', role: 'Restaurant Owner', message: 'RescueMeals has transformed how we manage food donations. The platform is intuitive and has helped us reduce waste significantly.'},
                    {name: 'Sarah Johnson', role: 'NGO Director', message: 'As an NGO, this platform has made it so much easier to connect with food donors. We\'ve been able to help more people than ever before.'},
                    {name: 'Mike Davis', role: 'Volunteer', message: 'Volunteering with RescueMeals has been incredibly rewarding. The system makes it easy to find and deliver food to those in need.'}
                ]).forEach(testimonial => { %>
                <div class="testimonial-card">
                    <div class="testimonial-quote">
                        <i class="fas fa-quote-left"></i>
                    </div>
                    <p class="testimonial-text">"<%= testimonial.message %>"</p>
                    <div class="testimonial-author">
                        <div class="testimonial-avatar">
                            <% if (testimonial.photo_url) { %>
                            <img src="<%= testimonial.photo_url %>" alt="<%= testimonial.name %>">
                            <% } else { %>
                            <i class="fas fa-user"></i>
                            <% } %>
                        </div>
                        <div class="testimonial-info">
                            <h4><%= testimonial.name %></h4>
                            <p><%= testimonial.role %></p>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section class="contact-section" id="contact">
        <div class="section-container">
            <div class="section-header">
                <h2><%= content.contact?.title || 'Contact Us' %></h2>
                <p><%= content.contact?.subtitle || 'Get in touch with our team' %></p>
            </div>
            <div class="contact-container">
                <div class="contact-info">
                    <h3><%= content.contact?.heading || "We'd Love to Hear From You" %></h3>
                    <p><%= content.contact?.description || 'Have questions about RescueMeals? Want to partner with us? Reach out and we\'ll get back to you as soon as possible.' %></p>
                    <div class="contact-details">
                        <div class="contact-item">
                            <i class="fas fa-map-marker-alt"></i>
                            <div>
                                <h4>Address</h4>
                                <p><%= content.contact?.address || 'Maharishi University of Information Technology (MUIT), Lucknow, Uttar Pradesh, India' %></p>
                            </div>
                        </div>
                        <div class="contact-item">
                            <i class="fas fa-phone"></i>
                            <div>
                                <h4>Phone</h4>
                                <p><%= content.contact?.phone || '+91 7232918655' %></p>
                            </div>
                        </div>
                        <div class="contact-item">
                            <i class="fas fa-envelope"></i>
                            <div>
                                <h4>Email</h4>
                                <p><%= content.contact?.email || 'support@rescuemeals.com' %></p>
                            </div>
                        </div>
                    </div>
                    <div class="map-container">
                        <iframe 
                            src="<%= content.contact?.mapEmbed || 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3559.1234567890123!2d80.9462!3d26.8467!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMjbCsDUwJzQ4LjEiTiA4MMKwNTYnNDYuMiJF!5e0!3m2!1sen!2sin!4v1234567890123!5m2!1sen!2sin' %>" 
                            width="100%" 
                            height="300" 
                            style="border:0; border-radius: 12px;" 
                            allowfullscreen="" 
                            loading="lazy" 
                            referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>
                </div>
                <div class="contact-form">
                    <h3>Send us a Message</h3>
                    <form id="contactForm">
                        <div class="form-group">
                            <label for="name">Full Name</label>
                            <input type="text" id="name" name="name" class="form-control" placeholder="Enter your name" required>
                        </div>
                        <div class="form-group">
                            <label for="email">Email Address</label>
                            <input type="email" id="email" name="email" class="form-control" placeholder="Enter your email" required>
                        </div>
                        <div class="form-group">
                            <label for="phone">Phone Number (Optional)</label>
                            <input type="tel" id="phone" name="phone" class="form-control" placeholder="Enter your phone number">
                        </div>
                        <div class="form-group">
                            <label for="subject">Subject</label>
                            <input type="text" id="subject" name="subject" class="form-control" placeholder="Enter subject" required>
                        </div>
                        <div class="form-group">
                            <label for="message">Message</label>
                            <textarea id="message" name="message" class="form-control" placeholder="Enter your message here..." required></textarea>
                        </div>
                        <button type="submit" id="submitBtn">
                            <i class="fas fa-paper-plane"></i> Send Message
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <!-- JavaScript for Animations -->
    <script>
        // Contact Form Submission
        const contactForm = document.getElementById('contactForm');
        if (contactForm) {
            contactForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                
                const submitBtn = document.getElementById('submitBtn');
                const originalText = submitBtn.innerHTML;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending...';
                submitBtn.disabled = true;
                
                const formData = {
                    name: document.getElementById('name').value,
                    email: document.getElementById('email').value,
                    phone: document.getElementById('phone').value,
                    subject: document.getElementById('subject').value,
                    message: document.getElementById('message').value
                };
                
                try {
                    const response = await fetch('/contact', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(formData)
                    });
                    
                    const data = await response.json();
                    
                    if (data.success) {
                        alert(data.message);
                        contactForm.reset();
                    } else {
                        alert(data.message || 'An error occurred. Please try again.');
                    }
                } catch (error) {
                    console.error('Error submitting form:', error);
                    alert('An error occurred. Please try again.');
                } finally {
                    submitBtn.innerHTML = originalText;
                    submitBtn.disabled = false;
                }
            });
        }

        // Animated Counter Function
        function animateCounter(element, target) {
            let current = 0;
            const increment = target / 100;
            const timer = setInterval(() => {
                current += increment;
                if (current >= target) {
                    element.textContent = target.toLocaleString() + '+';
                    clearInterval(timer);
                } else {
                    element.textContent = Math.floor(current).toLocaleString();
                }
            }, 20);
        }

        // Intersection Observer for Scroll Animations
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('animate-in');
                    
                    // Animate counters
                    const counters = entry.target.querySelectorAll('[data-target]');
                    counters.forEach(counter => {
                        const target = parseInt(counter.getAttribute('data-target'));
                        if (!counter.classList.contains('animated')) {
                            animateCounter(counter, target);
                            counter.classList.add('animated');
                        }
                    });
                    
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        // Observe all sections for scroll animations
        document.querySelectorAll('.about-section, .how-it-works-section, .features-section, .statistics-section, .partners-section, .testimonials-section, .contact-section').forEach(section => {
            section.classList.add('animate-on-scroll');
            observer.observe(section);
        });

        // Observe hero stats
        const heroStats = document.querySelector('.hero-stats');
        if (heroStats) {
            observer.observe(heroStats);
        }

        // Observe statistics section
        const statsSection = document.querySelector('.statistics-section');
        if (statsSection) {
            observer.observe(statsSection);
        }

        // Smooth scroll for all anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Add CSS for scroll animations
        const style = document.createElement('style');
        style.textContent = `
            .animate-on-scroll {
                opacity: 0;
                transform: translateY(40px);
                transition: opacity 0.8s ease, transform 0.8s ease;
            }
            
            .animate-on-scroll.animate-in {
                opacity: 1;
                transform: translateY(0);
            }
            
            .step-card, .feature-card, .partner-card, .testimonial-card {
                opacity: 0;
                transform: translateY(30px);
                transition: opacity 0.6s ease, transform 0.6s ease;
            }
            
            .animate-in .step-card,
            .animate-in .feature-card,
            .animate-in .partner-card,
            .animate-in .testimonial-card {
                opacity: 1;
                transform: translateY(0);
            }
            
            .animate-in .step-card:nth-child(1) { transition-delay: 0.1s; }
            .animate-in .step-card:nth-child(2) { transition-delay: 0.2s; }
            .animate-in .step-card:nth-child(3) { transition-delay: 0.3s; }
            .animate-in .step-card:nth-child(4) { transition-delay: 0.4s; }
            
            .animate-in .feature-card:nth-child(1) { transition-delay: 0.1s; }
            .animate-in .feature-card:nth-child(2) { transition-delay: 0.2s; }
            .animate-in .feature-card:nth-child(3) { transition-delay: 0.3s; }
            .animate-in .feature-card:nth-child(4) { transition-delay: 0.4s; }
            .animate-in .feature-card:nth-child(5) { transition-delay: 0.5s; }
            .animate-in .feature-card:nth-child(6) { transition-delay: 0.6s; }
        `;
        document.head.appendChild(style);
    </script>
</body>

</html>