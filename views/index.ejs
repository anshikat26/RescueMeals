<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= settings.seo_title || 'RescueMeals - Waste Food Management System' %></title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>

<body>
    <!-- Navigation Bar -->
    <%- include('partials/navbar') %>

    <!-- Hero Section -->
    <section class="hero-section" id="home">
        <div class="hero-content">
            <div class="hero-badge">
                <i class="fas fa-leaf"></i> Over 15,000+ Meals Saved & Distributed
            </div>
            <h1><%= content.home?.hero?.title || 'RescueMeals' %></h1>
            <p><%= content.home?.hero?.subtitle || 'Reduce Food Waste • Feed Needy People • Support NGOs' %></p>
            
            <% if (typeof user === 'undefined' || !user) { %>
            <div class="hero-role-pills">
                <label><i class="fas fa-bullseye"></i> Join as:</label>
                <a href="/signup" class="role-pill"><i class="fas fa-utensils"></i> Restaurant / Donor</a>
                <a href="/signup" class="role-pill"><i class="fas fa-building"></i> NGO Partner</a>
                <a href="/signup" class="role-pill"><i class="fas fa-hands-helping"></i> Volunteer</a>
            </div>
            <% } %>

            <div class="hero-buttons">
                <% if (typeof user !== 'undefined' && user) { %>
                    <% if (user.role === 'NGO') { %>
                        <a href="/ngo-dashboard" class="hero-btn hero-btn-amber">
                            <i class="fas fa-tachometer-alt"></i> Go to NGO Dashboard
                        </a>
                    <% } else if (user.role === 'Volunteer') { %>
                        <a href="/volunteer-dashboard" class="hero-btn hero-btn-amber">
                            <i class="fas fa-truck"></i> Go to Deliveries Dashboard
                        </a>
                    <% } else if (user.role === 'Admin') { %>
                        <a href="/admin/cms/home" class="hero-btn hero-btn-amber">
                            <i class="fas fa-user-shield"></i> Open Admin Panel
                        </a>
                    <% } else { %>
                        <a href="/donor-dashboard" class="hero-btn hero-btn-amber">
                            <i class="fas fa-tachometer-alt"></i> Go to Dashboard
                        </a>
                        <a href="/donate" class="hero-btn hero-btn-primary">
                            <i class="fas fa-hand-holding-heart"></i> Donate Food Now
                        </a>
                    <% } %>
                <% } else { %>
                    <a href="/signup" class="hero-btn hero-btn-amber">
                        <i class="fas fa-hand-holding-heart"></i> Donate Food Now
                    </a>
                    <a href="/signup" class="hero-btn hero-btn-primary">
                        <i class="fas fa-user-plus"></i> Get Started
                    </a>
                    <a href="/login" class="hero-btn hero-btn-secondary">
                        <i class="fas fa-sign-in-alt"></i> Login
                    </a>
                <% } %>
            </div>
            <div class="hero-stats">
                <div class="hero-stat-item">
                    <div class="hero-stat-number" data-target="<%= content.home?.hero?.stats?.meals || 5000 %>">0</div>
                    <div class="hero-stat-label"><%= content.home?.hero?.stats?.mealsLabel || 'Meals Saved' %></div>
                </div>
                <div class="hero-stat-item">
                    <div class="hero-stat-number" data-target="<%= content.home?.hero?.stats?.ngos || 200 %>">0</div>
                    <div class="hero-stat-label"><%= content.home?.hero?.stats?.ngosLabel || 'NGO Partners' %></div>
                </div>
                <div class="hero-stat-item">
                    <div class="hero-stat-number" data-target="<%= content.home?.hero?.stats?.volunteers || 150 %>">0</div>
                    <div class="hero-stat-label"><%= content.home?.hero?.stats?.volunteersLabel || 'Volunteers' %></div>
                </div>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section class="about-section" id="about">
        <div class="section-container">
            <div class="section-header">
                <h2><%= content.home?.about?.title || 'About RescueMeals India' %></h2>
                <p><%= content.home?.about?.subtitle || 'Connecting restaurants, banquet halls, and corporate canteens with verified NGOs and youth volunteers across India.' %></p>
            </div>
            <div class="about-content">
                <div class="about-image">
                    <img src="<%= content.home?.about?.image || '/images/indian-children-meals.jpg' %>" alt="Indian Children Food Donation Drive">
                </div>
                <div class="about-text">
                    <h3><%= content.home?.about?.heading || 'Nourishing Children & Eliminating Food Wastage' %></h3>
                    <p><%= content.home?.about?.description1 || 'RescueMeals is an authentic tech-driven food redistribution network dedicated to rescuing surplus, hygienic food from wedding halls, hotels, and college campuses across Indian cities.' %></p>
                    <p><%= content.home?.about?.description2 || 'Our mission aligns with the Zero Hunger Initiative—ensuring every extra meal is safely quality-tested and delivered to children at shelter homes, night care centers, and slum community schools.' %></p>
                    <div class="about-features">
                        <% const features = content.home?.about?.features || [
                            {icon: 'fa-child', text: 'Daily Meals for School Children'},
                            {icon: 'fa-shield-alt', text: '100% Quality & Hygiene Checked'},
                            {icon: 'fa-truck-loading', text: '30-Min Rapid Pickup Service'},
                            {icon: 'fa-award', text: 'Zero Waste Certified Platform'}
                        ]; %>
                        <% features.forEach(feature => { %>
                        <div class="about-feature">
                            <i class="fas <%= feature.icon || 'fa-check-circle' %>"></i>
                            <span><%= feature.text %></span>
                        </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Children & Community Impact Stories -->
    <section class="children-impact-section" id="impact-stories">
        <div class="section-container">
            <div class="section-header">
                <h2>Our Community Impact & Stories</h2>
                <p>Bringing warmth, smiles, and nutrition to children and families across India</p>
            </div>
            <div class="impact-cards-grid">
                <!-- Card 1 -->
                <div class="impact-card">
                    <div class="impact-card-img-wrapper">
                        <span class="impact-tag">Child Nutrition</span>
                        <img src="/images/indian-children-meals.jpg" alt="Indian School Children Eating Fresh Meals" class="impact-card-img">
                    </div>
                    <div class="impact-card-body">
                        <h3>Nourishing 4,500+ Children Daily</h3>
                        <p>Every evening, surplus food rescued from college cafeterias and wedding banquets is delivered to community learning centers in Lucknow and Delhi-NCR.</p>
                        <div class="impact-meta">
                            <span><i class="fas fa-heart"></i> 100% Fresh & Hygienic</span>
                            <span>Lucknow & NCR</span>
                        </div>
                    </div>
                </div>

                <!-- Card 2 -->
                <div class="impact-card">
                    <div class="impact-card-img-wrapper">
                        <span class="impact-tag">Youth Volunteers</span>
                        <img src="/images/volunteer-food-drive.jpg" alt="Indian Volunteer Distributing Meal Box" class="impact-card-img">
                    </div>
                    <div class="impact-card-body">
                        <h3>Direct Doorstep Meal Delivery</h3>
                        <p>Our network of 500+ active student volunteers coordinate real-time pickups to deliver sealed, insulated food boxes directly to night shelters before nightfall.</p>
                        <div class="impact-meta">
                            <span><i class="fas fa-clock"></i> Under 45 Mins Transit</span>
                            <span>Pan-India Network</span>
                        </div>
                    </div>
                </div>

                <!-- Card 3 -->
                <div class="impact-card">
                    <div class="impact-card-img-wrapper">
                        <span class="impact-tag">Food Security</span>
                        <img src="/images/hero-ngo-bg.jpg" alt="Community NGO Food Drive" class="impact-card-img">
                    </div>
                    <div class="impact-card-body">
                        <h3>Zero Waste Marriage Drive</h3>
                        <p>Partnered with over 120+ wedding venues and banquet halls to redirect excess food safely, saving over 15,000+ meals from going to landfills this year alone.</p>
                        <div class="impact-meta">
                            <span><i class="fas fa-leaf"></i> 15,000+ Meals Saved</span>
                            <span>50+ Cities</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section - Precious Theme -->
    <section class="features-section" id="features">
        <div class="section-container">
            <div class="section-header">
                <div class="features-precious-tag">
                    <i class="fas fa-gem"></i> Enterprise-Grade NGO Platform Features
                </div>
                <h2>Our Features</h2>
                <p>Everything you need to manage food donations, track impact, and eliminate waste efficiently</p>
            </div>

            <div class="features-grid">
                <!-- Feature 1: Real-time Notifications (Emerald Alert) -->
                <div class="feature-card feature-emerald">
                    <div class="feature-top-header">
                        <div class="feature-icon">
                            <i class="fas fa-bell"></i>
                        </div>
                        <span class="feature-gem-badge">Emerald Alert</span>
                    </div>
                    <h3>Real-time Notifications</h3>
                    <p>Get instant alerts when new food batches are available, claimed by NGOs, or dispatched for delivery.</p>
                    <div class="feature-preview-box">
                        <div class="preview-toast">
                            <i class="fas fa-check-circle"></i> <span>Instant Alert: 50 Meals Available nearby!</span>
                        </div>
                    </div>
                </div>

                <!-- Feature 2: Location Tracking (Sapphire GPS) -->
                <div class="feature-card feature-sapphire">
                    <div class="feature-top-header">
                        <div class="feature-icon">
                            <i class="fas fa-map-location-dot"></i>
                        </div>
                        <span class="feature-gem-badge">Sapphire GPS</span>
                    </div>
                    <h3>Live Location Tracking</h3>
                    <p>Track donation routes from kitchen pickup to doorstep delivery with live GPS updates and ETAs.</p>
                    <div class="feature-preview-box">
                        <div class="preview-gps">
                            <span><i class="fas fa-route"></i> Transit ETA: 14 Mins</span>
                            <span class="badge bg-primary">Live GPS</span>
                        </div>
                    </div>
                </div>

                <!-- Feature 3: Secure Platform (Ruby Shield) -->
                <div class="feature-card feature-ruby">
                    <div class="feature-top-header">
                        <div class="feature-icon">
                            <i class="fas fa-shield-halved"></i>
                        </div>
                        <span class="feature-gem-badge">Ruby Shield</span>
                    </div>
                    <h3>Secure & Compliant Platform</h3>
                    <p>Your organization data is protected with 256-bit encryption, strict RBAC, and FSSAI food quality protocols.</p>
                    <div class="feature-preview-box">
                        <div class="preview-ssl">
                            <i class="fas fa-lock"></i> <span>256-Bit Encrypted & FSSAI Compliant</span>
                        </div>
                    </div>
                </div>

                <!-- Feature 4: Impact Analytics (Gold Analytics) -->
                <div class="feature-card feature-amber">
                    <div class="feature-top-header">
                        <div class="feature-icon">
                            <i class="fas fa-chart-pie"></i>
                        </div>
                        <span class="feature-gem-badge">Gold Analytics</span>
                    </div>
                    <h3>Impact Analytics & ESG Reports</h3>
                    <p>Track your ESG contribution with automated monthly PDF reports, carbon offset stats, and meal growth charts.</p>
                    <div class="feature-preview-box">
                        <div class="preview-chart-bars">
                            <div class="chart-bar h-40"></div>
                            <div class="chart-bar h-65"></div>
                            <div class="chart-bar h-85"></div>
                            <div class="chart-bar h-100"></div>
                            <span style="margin-left: auto; color: #D97706;">+148% Growth</span>
                        </div>
                    </div>
                </div>

                <!-- Feature 5: Community Network (Amethyst Network) -->
                <div class="feature-card feature-violet">
                    <div class="feature-top-header">
                        <div class="feature-icon">
                            <i class="fas fa-users-viewfinder"></i>
                        </div>
                        <span class="feature-gem-badge">Amethyst Network</span>
                    </div>
                    <h3>Community Coalition</h3>
                    <p>Connect with 120+ restaurants, 200+ partner NGOs, and 500+ student volunteers across 50 Indian cities.</p>
                    <div class="feature-preview-box">
                        <div class="preview-avatars">
                            <div class="avatar-dot">NGO</div>
                            <div class="avatar-dot">VOL</div>
                            <div class="avatar-dot">DON</div>
                            <span>820+ Connected Partners</span>
                        </div>
                    </div>
                </div>

                <!-- Feature 6: Mobile Friendly & Offline Sync (Teal Sync) -->
                <div class="feature-card feature-teal">
                    <div class="feature-top-header">
                        <div class="feature-icon">
                            <i class="fas fa-mobile-screen-button"></i>
                        </div>
                        <span class="feature-gem-badge">Teal Sync</span>
                    </div>
                    <h3>Mobile-First & Offline Sync</h3>
                    <p>Access RescueMeals seamlessly from any smartphone, tablet, or desktop with offline form caching.</p>
                    <div class="feature-preview-box">
                        <div class="preview-devices">
                            <i class="fas fa-mobile-alt"></i> <span>Mobile App</span>
                            <i class="fas fa-laptop"></i> <span>Web Portal</span>
                            <span style="margin-left: auto; color: #0891B2;">100% Sync</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Statistics & Impact Section - Vibrant & Authentic -->
    <section class="statistics-section">
        <div class="section-container">
            <div class="section-header">
                <div class="impact-live-ticker">
                    <span class="pulse-dot"></span>
                    <span>⚡ Live Impact Tracker • 1 Fresh Meal Distributed Every 45 Seconds</span>
                </div>
                <h2 style="color: white; font-size: 38px;">Our Impact Across India</h2>
                <p style="color: rgba(255,255,255,0.9); max-width: 680px; margin: 0 auto;">Transparent, real-time statistics driving food dignity and environmental sustainability</p>
            </div>

            <div class="stats-grid">
                <!-- Stat 1: 15,000+ Meals Donated (Amber/Gold Theme) -->
                <div class="stat-item stat-item-amber">
                    <div class="stat-header">
                        <div class="stat-icon">
                            <i class="fas fa-bowl-food"></i>
                        </div>
                        <span class="stat-badge-chip">🍚 FSSAI Inspected</span>
                    </div>
                    <div>
                        <div class="stat-number" data-target="15000">0</div>
                        <div class="stat-label">Meals Donated</div>
                        <p class="stat-desc">Nutritious surplus meals safely redistributed to orphanages & night shelters.</p>
                    </div>
                </div>

                <!-- Stat 2: 250+ Partner NGOs (Emerald Theme) -->
                <div class="stat-item stat-item-emerald">
                    <div class="stat-header">
                        <div class="stat-icon">
                            <i class="fas fa-building-circle-check"></i>
                        </div>
                        <span class="stat-badge-chip">🤝 Verified Partners</span>
                    </div>
                    <div>
                        <div class="stat-number" data-target="250">0</div>
                        <div class="stat-label">Partner NGOs</div>
                        <p class="stat-desc">Authorized shelters & children welfare foundations actively claiming daily food batches.</p>
                    </div>
                </div>

                <!-- Stat 3: 500+ Active Volunteers (Sapphire Theme) -->
                <div class="stat-item stat-item-blue">
                    <div class="stat-header">
                        <div class="stat-icon">
                            <i class="fas fa-person-biking"></i>
                        </div>
                        <span class="stat-badge-chip">🚴 Doorstep Logistics</span>
                    </div>
                    <div>
                        <div class="stat-number" data-target="500">0</div>
                        <div class="stat-label">Active Volunteers</div>
                        <p class="stat-desc">Student heroes & community delivery partners ensuring rapid <30 min pickups.</p>
                    </div>
                </div>

                <!-- Stat 4: 50+ Cities Covered (Amethyst Theme) -->
                <div class="stat-item stat-item-violet">
                    <div class="stat-header">
                        <div class="stat-icon">
                            <i class="fas fa-city"></i>
                        </div>
                        <span class="stat-badge-chip">📍 Pan-India Reach</span>
                    </div>
                    <div>
                        <div class="stat-number" data-target="50">0</div>
                        <div class="stat-label">Cities Covered</div>
                        <p class="stat-desc">Operating in Lucknow, Delhi-NCR, Mumbai, Bengaluru, Hyderabad, and beyond.</p>
                    </div>
                </div>
            </div>

            <!-- Realistic Environmental Impact Footer Bar -->
            <div class="impact-footer-bar">
                <div class="impact-footer-item">
                    <i class="fas fa-leaf"></i> <span><strong>6.2 Tons</strong> Food Waste Prevented</span>
                </div>
                <div class="impact-footer-item">
                    <i class="fas fa-cloud-sun"></i> <span><strong>14.5 Tons</strong> CO₂ Emissions Reduced</span>
                </div>
                <div class="impact-footer-item">
                    <i class="fas fa-shield-heart"></i> <span><strong>99.8%</strong> Food Quality Standard</span>
                </div>
            </div>
        </div>
    </section>

    <!-- NGO/Partner Section - Authentic & Vibrant -->
    <section class="partners-section" id="partners">
        <div class="section-container">
            <div class="section-header">
                <div class="partners-tag">
                    <i class="fas fa-handshake-simple"></i> Accredited NGO & Institutional Network
                </div>
                <h2>Our Partners</h2>
                <p>Trusted non-profits, youth clubs, and sustainable catering networks driving zero-hunger across India</p>
            </div>

            <div class="partners-grid">
                <!-- Partner 1: Annapurna Foundation (Amber Theme) -->
                <div class="partner-card partner-card-amber">
                    <div class="partner-top-row">
                        <div class="partner-logo">
                            <i class="fas fa-bowl-rice"></i>
                        </div>
                        <span class="partner-category-badge">Food Relief</span>
                    </div>
                    <h3>Annapurna Foundation</h3>
                    <div class="partner-metric-box">
                        <i class="fas fa-utensils"></i> <span>Feeding 5,000+ daily</span>
                    </div>
                    <p>Providing daily wholesome meals to underprivileged families and daily wagers in Lucknow.</p>
                    <div class="partner-footer-chips">
                        <span class="partner-loc"><i class="fas fa-location-dot"></i> Lucknow, UP</span>
                        <span class="partner-seal"><i class="fas fa-certificate"></i> 80G Certified</span>
                    </div>
                </div>

                <!-- Partner 2: Asha Shelter Homes (Emerald Theme) -->
                <div class="partner-card partner-card-emerald">
                    <div class="partner-top-row">
                        <div class="partner-logo">
                            <i class="fas fa-hands-holding-child"></i>
                        </div>
                        <span class="partner-category-badge">Child Welfare</span>
                    </div>
                    <h3>Asha Shelter Homes</h3>
                    <div class="partner-metric-box">
                        <i class="fas fa-child"></i> <span>Supporting 40+ Child Centers</span>
                    </div>
                    <p>Delivering daily hot meals, primary nutrition, and care for street children across shelters.</p>
                    <div class="partner-footer-chips">
                        <span class="partner-loc"><i class="fas fa-location-dot"></i> Delhi-NCR</span>
                        <span class="partner-seal"><i class="fas fa-shield-check"></i> Verified NGO</span>
                    </div>
                </div>

                <!-- Partner 3: Green Earth Trust India (Teal Theme) -->
                <div class="partner-card partner-card-teal">
                    <div class="partner-top-row">
                        <div class="partner-logo">
                            <i class="fas fa-leaf"></i>
                        </div>
                        <span class="partner-category-badge">Zero Waste</span>
                    </div>
                    <h3>Green Earth Trust India</h3>
                    <div class="partner-metric-box">
                        <i class="fas fa-recycle"></i> <span>Zero Waste Weddings Partner</span>
                    </div>
                    <p>Pioneering zero-food-waste protocols for large banquet halls, weddings, and corporate summits.</p>
                    <div class="partner-footer-chips">
                        <span class="partner-loc"><i class="fas fa-location-dot"></i> Mumbai & BLR</span>
                        <span class="partner-seal"><i class="fas fa-seedling"></i> Eco Alliance</span>
                    </div>
                </div>

                <!-- Partner 4: Rotary Youth Club (Violet Theme) -->
                <div class="partner-card partner-card-violet">
                    <div class="partner-top-row">
                        <div class="partner-logo">
                            <i class="fas fa-user-graduate"></i>
                        </div>
                        <span class="partner-category-badge">Youth Movement</span>
                    </div>
                    <h3>Rotary Youth Club</h3>
                    <div class="partner-metric-box">
                        <i class="fas fa-users-viewfinder"></i> <span>500+ Active Student Volunteers</span>
                    </div>
                    <p>Empowering university students to execute rapid doorstep food pickups and neighborhood distribution.</p>
                    <div class="partner-footer-chips">
                        <span class="partner-loc"><i class="fas fa-location-dot"></i> Pan-India</span>
                        <span class="partner-seal"><i class="fas fa-bolt"></i> Active Logistics</span>
                    </div>
                </div>
            </div>

            <!-- Partner Coalition Callout Banner -->
            <div class="partner-coalition-box">
                <div class="coalition-text">
                    <i class="fas fa-hands-clapping"></i>
                    <span><strong>Join 250+ Verified Organizations.</strong> Partner with RescueMeals to eliminate food waste in your city.</span>
                </div>
                <a href="/signup" class="coalition-btn"><i class="fas fa-plus"></i> Join as Partner</a>
            </div>
        </div>
    </section>

    <!-- Testimonials Section - Vibrant & Authentic Stories -->
    <section class="testimonials-section" id="testimonials">
        <div class="section-container">
            <div class="section-header">
                <div class="testimonials-tag">
                    <i class="fas fa-heart-pulse"></i> Real Voices & Ground Stories
                </div>
                <h2>Stories of Impact</h2>
                <p>Hear from our restaurant donors, NGO shelter leaders, and dedicated youth volunteers</p>
            </div>

            <div class="testimonials-grid">
                <!-- Testimonial 1: Restaurant Donor (Amber Theme) -->
                <div class="testimonial-card testimonial-card-amber">
                    <div class="testimonial-top-row">
                        <span class="testimonial-role-badge">🏨 Banquet Donor</span>
                        <div class="testimonial-rating">
                            <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                        </div>
                    </div>
                    <div class="quote-bg-icon">
                        <i class="fas fa-quote-left"></i>
                    </div>
                    <p class="testimonial-text">"Instead of wasting extra food after large wedding receptions, RescueMeals allows us to schedule rapid pickups in 10 minutes. Knowing it feeds children at night shelters brings immense peace."</p>
                    <div class="testimonial-author">
                        <div class="avatar-initials amber">RV</div>
                        <div class="testimonial-info">
                            <h4>Rajesh Verma</h4>
                            <p>General Manager, Royal Banquet Lucknow</p>
                            <span class="testimonial-highlight-tag"><i class="fas fa-bolt"></i> 10-Min Pickup Verified</span>
                        </div>
                    </div>
                </div>

                <!-- Testimonial 2: NGO Director (Emerald Theme) -->
                <div class="testimonial-card testimonial-card-emerald">
                    <div class="testimonial-top-row">
                        <span class="testimonial-role-badge">🏢 NGO Partner</span>
                        <div class="testimonial-rating">
                            <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                        </div>
                    </div>
                    <div class="quote-bg-icon">
                        <i class="fas fa-quote-left"></i>
                    </div>
                    <p class="testimonial-text">"RescueMeals has made food sourcing seamless. We receive hot, wholesome meals for over 120 children every single day. The quality and hygiene are exceptional."</p>
                    <div class="testimonial-author">
                        <div class="avatar-initials emerald">SD</div>
                        <div class="testimonial-info">
                            <h4>Sunita Devi</h4>
                            <p>Director, Asha Children Home</p>
                            <span class="testimonial-highlight-tag"><i class="fas fa-bowl-food"></i> 120+ Daily Children Fed</span>
                        </div>
                    </div>
                </div>

