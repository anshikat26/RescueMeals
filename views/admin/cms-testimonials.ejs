<%- include('cms-dashboard', { pageTitle: 'Testimonials CMS', activePage: 'testimonials', user: user }) %>

<div class="cms-card">
    <div class="cms-card-header">
        <h2 class="cms-card-title">Testimonials</h2>
        <div class="cms-card-actions">
            <button class="cms-btn cms-btn-primary" onclick="openAddTestimonialModal()">
                <i class="fas fa-plus"></i> Add Testimonial
            </button>
        </div>
    </div>

    <div id="testimonialList">
        <!-- Testimonials loaded here -->
    </div>
</div>

<!-- Add / Edit Modal -->
<div class="cms-modal" id="testimonialModal">
    <div class="cms-modal-content">
        <div class="cms-modal-header">
            <h3 id="testimonialModalTitle">Add Testimonial</h3>
            <button class="cms-modal-close" onclick="closeTestimonialModal()">&times;</button>
        </div>
        <div class="cms-modal-body">
            <form id="testimonialForm">
                <input type="hidden" id="testimonialId">
                <div class="cms-form-row">
                    <div class="cms-form-group">
                        <label class="cms-form-label">Name</label>
                        <input type="text" class="cms-form-input" id="testimonialName" placeholder="Person's name" required>
                    </div>
                    <div class="cms-form-group">
                        <label class="cms-form-label">Role</label>
                        <input type="text" class="cms-form-input" id="testimonialRole" placeholder="Donor / NGO / Volunteer">
                    </div>
                </div>
                <div class="cms-form-group">
                    <label class="cms-form-label">Message</label>
                    <textarea class="cms-form-textarea" id="testimonialMessage" placeholder="Enter testimonial message" required></textarea>
                </div>
                <div class="cms-form-row">
                    <div class="cms-form-group">
                        <label class="cms-form-label">Rating (1-5)</label>
                        <input type="number" class="cms-form-input" id="testimonialRating" min="1" max="5" value="5">
                    </div>
                    <div class="cms-form-group">
                        <label class="cms-form-label">Order</label>
                        <input type="number" class="cms-form-input" id="testimonialOrder" value="0">
                    </div>
                </div>
                <div class="cms-form-group">
                    <label class="cms-form-label">Photo</label>
                    <input type="file" accept="image/*" class="cms-form-input" id="testimonialFile" onchange="previewTestimonialPhoto(this)">
                    <input type="hidden" id="testimonialPhotoUrl">
                    <img id="testimonialPreview" class="cms-image-preview" alt="Preview">
                </div>
                <div class="cms-form-group">
                    <label class="cms-form-label">
                        <input type="checkbox" id="testimonialActive" checked> Active (visible on website)
                    </label>
                </div>
            </form>
        </div>
        <div class="cms-modal-footer">
            <button class="cms-btn cms-btn-secondary" onclick="closeTestimonialModal()">Cancel</button>
            <button class="cms-btn cms-btn-primary" onclick="saveTestimonial()">
                <i class="fas fa-save"></i> Save
            </button>
        </div>
    </div>
</div>

<script>
    function escapeHtml(str) {
        return String(str || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function stars(n) {
        n = parseInt(n) || 0;
        let out = '';
        for (let i = 0; i < 5; i++) {
            out += i < n ? '<i class="fas fa-star" style="color:#f59e0b;"></i>' : '<i class="far fa-star" style="color:#d1d5db;"></i>';
        }
        return out;
    }

    async function loadTestimonials() {
        const list = document.getElementById('testimonialList');
        try {
            const response = await fetch('/api/cms/testimonials?all=true');
            const testimonials = await response.json();

            if (!testimonials.length) {
                list.innerHTML = '<div class="cms-empty-state"><i class="fas fa-quote-left"></i><h3>No testimonials yet</h3><p>Add your first testimonial to get started.</p></div>';
                return;
            }

            list.innerHTML = testimonials.map(t => `
                <div class="cms-list-item">
                    <div class="cms-list-item-content">
                        <h4>${escapeHtml(t.name)} <small style="color:#6b7280;font-weight:400;">${escapeHtml(t.role || '')}</small> ${t.is_active ? '' : '<span style="color:#9ca3af;font-size:12px;">(hidden)</span>'}</h4>
                        <div style="margin:4px 0;">${stars(t.rating)}</div>
                        <p>${escapeHtml(t.message)}</p>
                    </div>
                    <div class="cms-list-item-actions">
                        <button class="cms-btn cms-btn-secondary cms-btn-sm" onclick='editTestimonial(${JSON.stringify(t)})'>
                            <i class="fas fa-edit"></i>
                        </button>
                        <button class="cms-btn cms-btn-danger cms-btn-sm" onclick="deleteTestimonial('${t._id}')">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            `).join('');
        } catch (error) {
            console.error('Error loading testimonials:', error);
            list.innerHTML = '<div class="cms-empty-state"><i class="fas fa-exclamation-triangle"></i><h3>Failed to load testimonials</h3></div>';
        }
    }

    function openAddTestimonialModal() {
        document.getElementById('testimonialModalTitle').textContent = 'Add Testimonial';
        document.getElementById('testimonialId').value = '';
        document.getElementById('testimonialName').value = '';
        document.getElementById('testimonialRole').value = '';
        document.getElementById('testimonialMessage').value = '';
        document.getElementById('testimonialRating').value = '5';
        document.getElementById('testimonialOrder').value = '0';
        document.getElementById('testimonialPhotoUrl').value = '';
        document.getElementById('testimonialFile').value = '';
        document.getElementById('testimonialPreview').classList.remove('show');
        document.getElementById('testimonialActive').checked = true;
        document.getElementById('testimonialModal').classList.add('show');
    }

    function editTestimonial(t) {
        document.getElementById('testimonialModalTitle').textContent = 'Edit Testimonial';
        document.getElementById('testimonialId').value = t._id;
        document.getElementById('testimonialName').value = t.name || '';
        document.getElementById('testimonialRole').value = t.role || '';
        document.getElementById('testimonialMessage').value = t.message || '';
        document.getElementById('testimonialRating').value = t.rating || 5;
        document.getElementById('testimonialOrder').value = t.order || 0;
        document.getElementById('testimonialPhotoUrl').value = t.photo_url || '';
        document.getElementById('testimonialFile').value = '';
        const preview = document.getElementById('testimonialPreview');
        if (t.photo_url) {
            preview.src = t.photo_url;
            preview.classList.add('show');
        } else {
            preview.classList.remove('show');
        }
        document.getElementById('testimonialActive').checked = t.is_active !== false;
        document.getElementById('testimonialModal').classList.add('show');
    }

    function closeTestimonialModal() {
        document.getElementById('testimonialModal').classList.remove('show');
    }

    async function previewTestimonialPhoto(input) {
        const file = input.files[0];
        if (!file) return;
        try {
            showToast('Uploading photo...');
            const url = await uploadImage(file);
            document.getElementById('testimonialPhotoUrl').value = url;
            const preview = document.getElementById('testimonialPreview');
            preview.src = url;
            preview.classList.add('show');
            showToast('Photo uploaded! Click Save to finish.');
        } catch (error) {
            console.error('Error uploading photo:', error);
            showToast(error.message || 'Error uploading photo', 'error');
        }
    }

    async function saveTestimonial() {
        const id = document.getElementById('testimonialId').value;
        const name = document.getElementById('testimonialName').value.trim();
        const message = document.getElementById('testimonialMessage').value.trim();

        if (!name || !message) {
            showToast('Name and message are required', 'error');
            return;
        }

        const payload = {
            name: name,
            role: document.getElementById('testimonialRole').value,
            message: message,
            rating: parseInt(document.getElementById('testimonialRating').value) || 5,
            order: parseInt(document.getElementById('testimonialOrder').value) || 0,
            photo_url: document.getElementById('testimonialPhotoUrl').value,
            is_active: document.getElementById('testimonialActive').checked
        };

        try {
            const url = id ? `/api/cms/testimonials/${id}` : '/api/cms/testimonials';
            const method = id ? 'PUT' : 'POST';
            const response = await fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (response.ok) {
                showToast(id ? 'Testimonial updated successfully!' : 'Testimonial added successfully!');
                closeTestimonialModal();
                loadTestimonials();
            } else {
                showToast('Error saving testimonial', 'error');
            }
        } catch (error) {
            console.error('Error saving testimonial:', error);
            showToast('Error saving testimonial', 'error');
        }
    }

    async function deleteTestimonial(id) {
        if (!confirm('Are you sure you want to delete this testimonial?')) return;
        try {
            const response = await fetch(`/api/cms/testimonials/${id}`, { method: 'DELETE' });
            if (response.ok) {
                showToast('Testimonial deleted successfully!');
                loadTestimonials();
            } else {
                showToast('Error deleting testimonial', 'error');
            }
        } catch (error) {
            console.error('Error deleting testimonial:', error);
            showToast('Error deleting testimonial', 'error');
        }
    }

    document.addEventListener('DOMContentLoaded', loadTestimonials);
</script>

<%- include('cms-dashboard-end') %>
