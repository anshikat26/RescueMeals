<%- include('cms-dashboard', { pageTitle: 'Contact Messages', activePage: 'messages', user: user }) %>

<div class="cms-card">
    <div class="cms-card-header">
        <h2 class="cms-card-title">Contact Messages</h2>
        <div class="cms-card-actions">
            <input type="text" class="cms-form-input" id="searchInput" placeholder="Search messages..." style="width: 220px;" oninput="onSearch()">
            <a href="/api/cms/contact-messages/export" class="cms-btn cms-btn-secondary">
                <i class="fas fa-download"></i> Export CSV
            </a>
        </div>
    </div>

    <div id="messagesList">
        <!-- Messages loaded here -->
    </div>

    <div id="pagination" class="cms-pagination" style="margin-top: 16px; display:flex; gap:8px; align-items:center;"></div>
</div>

<script>
    let currentPage = 1;
    const limit = 10;
    let searchQuery = '';
    let searchTimer = null;

    function escapeHtml(str) {
        return String(str || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function onSearch() {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
            searchQuery = document.getElementById('searchInput').value;
            currentPage = 1;
            loadMessages();
        }, 300);
    }

    async function loadMessages() {
        const list = document.getElementById('messagesList');
        try {
            const response = await fetch(`/api/cms/contact-messages?page=${currentPage}&limit=${limit}&search=${encodeURIComponent(searchQuery)}`);
            const data = await response.json();
            const messages = data.messages || [];

            if (!messages.length) {
                list.innerHTML = '<div class="cms-empty-state"><i class="fas fa-envelope-open"></i><h3>No messages found</h3></div>';
                document.getElementById('pagination').innerHTML = '';
                return;
            }

            list.innerHTML = messages.map(msg => `
                <div class="cms-list-item" style="${msg.is_read ? 'opacity:0.7;' : ''}">
                    <div class="cms-list-item-content">
                        <h4>
                            ${escapeHtml(msg.subject)}
                            ${msg.is_read ? '<span style="color:#9ca3af;font-size:12px;">(read)</span>' : '<span style="color:#16a34a;font-size:12px;font-weight:600;">(new)</span>'}
                        </h4>
                        <p><strong>${escapeHtml(msg.name)}</strong> &lt;${escapeHtml(msg.email)}&gt; ${msg.phone ? '&middot; ' + escapeHtml(msg.phone) : ''}</p>
                        <p>${escapeHtml(msg.message)}</p>
                        <small style="color:#6b7280;">${new Date(msg.created_at).toLocaleString()}</small>
                    </div>
                    <div class="cms-list-item-actions">
                        ${msg.is_read ? '' : `<button class="cms-btn cms-btn-secondary cms-btn-sm" onclick="markRead('${msg._id}')"><i class="fas fa-check"></i> Mark read</button>`}
                        <button class="cms-btn cms-btn-danger cms-btn-sm" onclick="deleteMessage('${msg._id}')">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            `).join('');

            renderPagination(data.pages || 1);
        } catch (error) {
            console.error('Error loading messages:', error);
            list.innerHTML = '<div class="cms-empty-state"><i class="fas fa-exclamation-triangle"></i><h3>Failed to load messages</h3></div>';
        }
    }

    function renderPagination(pages) {
        const container = document.getElementById('pagination');
        if (pages <= 1) { container.innerHTML = ''; return; }
        let html = '';
        html += `<button class="cms-btn cms-btn-secondary cms-btn-sm" ${currentPage <= 1 ? 'disabled' : ''} onclick="gotoPage(${currentPage - 1})">Prev</button>`;
        html += `<span>Page ${currentPage} of ${pages}</span>`;
        html += `<button class="cms-btn cms-btn-secondary cms-btn-sm" ${currentPage >= pages ? 'disabled' : ''} onclick="gotoPage(${currentPage + 1})">Next</button>`;
        container.innerHTML = html;
    }

    function gotoPage(p) {
        currentPage = p;
        loadMessages();
    }

    async function markRead(id) {
        try {
            const response = await fetch(`/api/cms/contact-messages/${id}/read`, { method: 'PUT' });
            if (response.ok) {
                showToast('Message marked as read!');
                loadMessages();
            } else {
                showToast('Error updating message', 'error');
            }
        } catch (error) {
            console.error('Error marking read:', error);
            showToast('Error updating message', 'error');
        }
    }

    async function deleteMessage(id) {
        if (!confirm('Are you sure you want to delete this message?')) return;
        try {
            const response = await fetch(`/api/cms/contact-messages/${id}`, { method: 'DELETE' });
            if (response.ok) {
                showToast('Message deleted successfully!');
                loadMessages();
            } else {
                showToast('Error deleting message', 'error');
            }
        } catch (error) {
            console.error('Error deleting message:', error);
            showToast('Error deleting message', 'error');
        }
    }

    document.addEventListener('DOMContentLoaded', loadMessages);
</script>

<%- include('cms-dashboard-end') %>
