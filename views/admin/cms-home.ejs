<%- include('cms-dashboard', { pageTitle: 'Home Page CMS', activePage: 'home', user: user }) %>

<!-- HERO SECTION CARD -->
<div class="cms-card">
    <div class="cms-card-header">
        <h2 class="cms-card-title"><i class="fas fa-star text-success me-2"></i>Hero Section</h2>
        <div class="cms-card-actions">
            <button class="cms-btn cms-btn-primary" onclick="saveHeroSection()">
                <i class="fas fa-save"></i> Save Changes
            </button>
        </div>
    </div>

    <form id="heroForm">
        <div class="cms-form-row">
            <div class="cms-form-group">
                <label class="cms-form-label">Hero Title</label>
                <input type="text" class="cms-form-input" id="heroTitle" placeholder="Enter hero title">
            </div>
            <div class="cms-form-group">
                <label class="cms-form-label">Hero Subtitle</label>
                <input type="text" class="cms-form-input" id="heroSubtitle" placeholder="Enter hero subtitle">
            </div>
        </div>

        <div class="cms-form-group">
            <label class="cms-form-label">Hero Description</label>
            <textarea class="cms-form-textarea" id="heroDescription" placeholder="Enter hero description"></textarea>
        </div>

        <div class="cms-form-row">
            <div class="cms-form-group">
                <label class="cms-form-label">Hero Image URL</label>
                <input type="text" class="cms-form-input" id="heroImage" placeholder="Enter hero image URL or upload below">
                <input type="file" accept="image/*" id="heroImageFile" class="cms-form-input" style="margin-top:8px;" onchange="uploadHeroImage(this)">
                <img id="heroImagePreview" class="cms-image-preview" alt="Hero preview">
            </div>
            <div class="cms-form-group">
                <label class="cms-form-label">CTA Button Text</label>
                <input type="text" class="cms-form-input" id="ctaText" placeholder="Enter CTA button text">
            </div>
        </div>

        <div class="cms-form-group">
            <label class="cms-form-label">CTA Button Link</label>
            <input type="text" class="cms-form-input" id="ctaLink" placeholder="Enter CTA button link">
        </div>
    </form>
</div>

<!-- STATISTICS CARD -->
<div class="cms-card">
    <div class="cms-card-header">
        <h2 class="cms-card-title"><i class="fas fa-chart-line text-success me-2"></i>Impact Statistics</h2>
        <div class="cms-card-actions">
            <button class="cms-btn cms-btn-primary" onclick="saveStatistics()">
                <i class="fas fa-save"></i> Save Changes
            </button>
        </div>
    </div>

    <form id="statsForm">
        <div class="cms-form-row">
            <div class="cms-form-group">
                <label class="cms-form-label">Meals Donated Count</label>
                <input type="number" class="cms-form-input" id="statDonations" placeholder="e.g. 15000">
            </div>
            <div class="cms-form-group">
                <label class="cms-form-label">Partner NGOs Count</label>
                <input type="number" class="cms-form-input" id="statNGOs" placeholder="e.g. 250">
            </div>
            <div class="cms-form-group">
                <label class="cms-form-label">Active Volunteers Count</label>
                <input type="number" class="cms-form-input" id="statVolunteers" placeholder="e.g. 500">
            </div>
            <div class="cms-form-group">
                <label class="cms-form-label">People Helped Count</label>
                <input type="number" class="cms-form-input" id="statPeople" placeholder="e.g. 45000">
            </div>
        </div>
    </form>
</div>

<!-- ABOUT SECTION CARD -->
<div class="cms-card">
    <div class="cms-card-header">
        <h2 class="cms-card-title"><i class="fas fa-info-circle text-success me-2"></i>About Section</h2>
        <div class="cms-card-actions">
            <button class="cms-btn cms-btn-primary" onclick="saveAboutSection()">
                <i class="fas fa-save"></i> Save Changes
            </button>
        </div>
    </div>

    <form id="aboutSectionForm">
        <div class="cms-form-group">
            <label class="cms-form-label">About Heading</label>
            <input type="text" class="cms-form-input" id="aboutHeading" placeholder="e.g. Making a Difference Together Every Day">
        </div>

        <div class="cms-form-group">
            <label class="cms-form-label">Description Paragraph 1</label>
            <textarea class="cms-form-textarea" id="aboutDesc1" placeholder="First paragraph about RescueMeals mission..."></textarea>
        </div>

        <div class="cms-form-group">
            <label class="cms-form-label">Description Paragraph 2</label>
            <textarea class="cms-form-textarea" id="aboutDesc2" placeholder="Second paragraph about safety & food rescue..."></textarea>
        </div>

        <div class="cms-form-group">
            <label class="cms-form-label">About Image URL</label>
            <input type="text" class="cms-form-input" id="aboutImage" placeholder="Image URL for about section">
        </div>
    </form>
</div>

<!-- FEATURES CARD -->
<div class="cms-card">
    <div class="cms-card-header">
        <h2 class="cms-card-title"><i class="fas fa-list text-success me-2"></i>Features & Bento Highlights</h2>
        <div class="cms-card-actions">
            <button class="cms-btn cms-btn-primary" onclick="saveFeatures()">
                <i class="fas fa-save"></i> Save Changes
            </button>
        </div>
    </div>

    <form id="featuresForm">
        <div id="featuresContainer">
            <!-- Dynamic features list -->
        </div>
        <button type="button" class="cms-btn cms-btn-secondary cms-btn-sm" onclick="addFeature()">
            <i class="fas fa-plus"></i> Add Feature
        </button>
    </form>
</div>

<script>
    // Global image upload helper
    async function uploadImage(file) {
        const formData = new FormData();
        formData.append('image', file);
        const res = await fetch('/api/cms/upload', {
            method: 'POST',
            body: formData
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.message || 'Upload failed');
        return data.url;
    }

    // Hero image upload
    function showHeroPreview(url) {
        const preview = document.getElementById('heroImagePreview');
        if (url) {
            preview.src = url;
            preview.classList.add('show');
        } else {
            preview.classList.remove('show');
        }
    }

    async function uploadHeroImage(input) {
        const file = input.files[0];
        if (!file) return;
        try {
            showToast('Uploading image...');
            const url = await uploadImage(file);
            document.getElementById('heroImage').value = url;
            showHeroPreview(url);
            showToast('Image uploaded! Click Save Changes to apply.');
        } catch (error) {
            console.error('Error uploading hero image:', error);
            showToast(error.message || 'Error uploading image', 'error');
        }
    }

    // Load hero section data
    async function loadHeroSection() {
        try {
            const response = await fetch('/api/cms/content/home/hero');
            const data = await response.json();

            if (data.content) {
                document.getElementById('heroTitle').value = data.content.title || '';
                document.getElementById('heroSubtitle').value = data.content.subtitle || '';
                document.getElementById('heroDescription').value = data.content.description || '';
                document.getElementById('heroImage').value = data.content.image || '';
                showHeroPreview(data.content.image || '');
                document.getElementById('ctaText').value = data.content.ctaText || '';
                document.getElementById('ctaLink').value = data.content.ctaLink || '';
            }
        } catch (error) {
            console.error('Error loading hero section:', error);
        }
    }

    // Save hero section
    async function saveHeroSection() {
        const content = {
            title: document.getElementById('heroTitle').value,
            subtitle: document.getElementById('heroSubtitle').value,
            description: document.getElementById('heroDescription').value,
            image: document.getElementById('heroImage').value,
            ctaText: document.getElementById('ctaText').value,
            ctaLink: document.getElementById('ctaLink').value
        };

        try {
            const response = await fetch('/api/cms/content/home/hero', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(content)
            });

            if (response.ok) {
                showToast('Hero section saved successfully!');
            } else {
                showToast('Error saving hero section', 'error');
            }
        } catch (error) {
            console.error('Error saving hero section:', error);
            showToast('Error saving hero section', 'error');
        }
    }

    // Load statistics
    async function loadStatistics() {
        try {
            const response = await fetch('/api/cms/content/home/statistics');
            const data = await response.json();

            if (data.content) {
                document.getElementById('statDonations').value = data.content.donations || '';
                document.getElementById('statNGOs').value = data.content.ngos || '';
                document.getElementById('statVolunteers').value = data.content.volunteers || '';
                document.getElementById('statPeople').value = data.content.people || '';
            }
        } catch (error) {
            console.error('Error loading statistics:', error);
        }
    }

    // Save statistics
    async function saveStatistics() {
        const content = {
            donations: parseInt(document.getElementById('statDonations').value) || 0,
            ngos: parseInt(document.getElementById('statNGOs').value) || 0,
            volunteers: parseInt(document.getElementById('statVolunteers').value) || 0,
            people: parseInt(document.getElementById('statPeople').value) || 0
        };

        try {
            const response = await fetch('/api/cms/content/home/statistics', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(content)
            });

            if (response.ok) {
                showToast('Statistics saved successfully!');
            } else {
                showToast('Error saving statistics', 'error');
            }
        } catch (error) {
            console.error('Error saving statistics:', error);
            showToast('Error saving statistics', 'error');
        }
    }

    // Load About section
    async function loadAboutSection() {
        try {
            const response = await fetch('/api/cms/content/home/about');
            const data = await response.json();

            if (data.content) {
                document.getElementById('aboutHeading').value = data.content.heading || '';
                document.getElementById('aboutDesc1').value = data.content.description1 || '';
                document.getElementById('aboutDesc2').value = data.content.description2 || '';
                document.getElementById('aboutImage').value = data.content.image || '';
            }
        } catch (error) {
            console.error('Error loading about section:', error);
        }
    }

    // Save About section
    async function saveAboutSection() {
        const content = {
            heading: document.getElementById('aboutHeading').value,
            description1: document.getElementById('aboutDesc1').value,
            description2: document.getElementById('aboutDesc2').value,
            image: document.getElementById('aboutImage').value
        };

        try {
            const response = await fetch('/api/cms/content/home/about', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(content)
            });

            if (response.ok) {
                showToast('About section saved successfully!');
            } else {
                showToast('Error saving about section', 'error');
            }
        } catch (error) {
            console.error('Error saving about section:', error);
            showToast('Error saving about section', 'error');
        }
    }

    // Load features
    async function loadFeatures() {
        try {
            const response = await fetch('/api/cms/content/home/features');
            const data = await response.json();

            if (data.content && data.content.features) {
                const container = document.getElementById('featuresContainer');
                container.innerHTML = '';
                data.content.features.forEach((feature) => {
                    addFeature(feature.title, feature.description, feature.icon);
                });
            }
        } catch (error) {
            console.error('Error loading features:', error);
        }
    }

    // Add feature item
    function addFeature(title = '', description = '', icon = '') {
        const container = document.getElementById('featuresContainer');
        const featureDiv = document.createElement('div');
        featureDiv.className = 'cms-form-row feature-item';
        featureDiv.innerHTML = `
            <div class="cms-form-group">
                <label class="cms-form-label">Feature Title</label>
                <input type="text" class="cms-form-input feature-title" value="${title}" placeholder="Enter feature title">
            </div>
            <div class="cms-form-group">
                <label class="cms-form-label">Feature Description</label>
                <input type="text" class="cms-form-input feature-description" value="${description}" placeholder="Enter feature description">
            </div>
            <div class="cms-form-group">
                <label class="cms-form-label">Icon Class (Font Awesome)</label>
                <input type="text" class="cms-form-input feature-icon" value="${icon}" placeholder="e.g. fas fa-leaf">
            </div>
            <div class="cms-form-group">
                <label class="cms-form-label">&nbsp;</label>
                <button type="button" class="cms-btn cms-btn-danger cms-btn-sm" onclick="removeFeature(this)">
                    <i class="fas fa-trash"></i>
                </button>
            </div>
        `;
        container.appendChild(featureDiv);
    }

    function removeFeature(button) {
        button.closest('.feature-item').remove();
    }

    async function saveFeatures() {
        const features = [];
        document.querySelectorAll('.feature-item').forEach(item => {
            features.push({
                title: item.querySelector('.feature-title').value,
                description: item.querySelector('.feature-description').value,
                icon: item.querySelector('.feature-icon').value
            });
        });

        try {
            const response = await fetch('/api/cms/content/home/features', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ features })
            });

            if (response.ok) {
                showToast('Features saved successfully!');
            } else {
                showToast('Error saving features', 'error');
            }
        } catch (error) {
            console.error('Error saving features:', error);
            showToast('Error saving features', 'error');
        }
    }

    // Load all sections on page load
    document.addEventListener('DOMContentLoaded', function() {
        loadHeroSection();
        loadStatistics();
        loadAboutSection();
        loadFeatures();
    });
</script>

<%- include('cms-dashboard-end') %>
