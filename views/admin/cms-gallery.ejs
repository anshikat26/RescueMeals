<%- include('cms-dashboard', { pageTitle: 'Gallery CMS', activePage: 'gallery', user: user }) %>

<div class="cms-card">
    <div class="cms-card-header">
        <h2 class="cms-card-title">Gallery Images</h2>
        <div class="cms-card-actions">
            <button class="cms-btn cms-btn-primary" onclick="openUploadModal()">
                <i class="fas fa-upload"></i> Upload Image
            </button>
        </div>
    </div>

    <div id="galleryGrid" class="cms-gallery-grid">
        <!-- Gallery images loaded here -->
    </div>
</div>

<!-- Upload / Edit Modal -->
<div class="cms-modal" id="galleryModal">
    <div class="cms-modal-content">
        <div class="cms-modal-header">
            <h3 id="galleryModalTitle">Upload Image</h3>
            <button class="cms-modal-close" onclick="closeGalleryModal()">&times;</button>
        </div>
        <div class="cms-modal-body">
            <form id="galleryForm">
                <input type="hidden" id="galleryId">
                <div class="cms-form-group">
                    <label class="cms-form-label">Title</label>
                    <input type="text" class="cms-form-input" id="galleryTitle" placeholder="Enter image title" required>
                </div>
                <div class="cms-form-group">
                    <label class="cms-form-label">Alt Text</label>
                    <input type="text" class="cms-form-input" id="galleryAlt" placeholder="Describe the image">
                </div>
                <div class="cms-form-group">
                    <label class="cms-form-label">Image</label>
                    <input type="file" accept="image/*" class="cms-form-input" id="galleryFile" onchange="previewGalleryImage(this)">
                    <input type="hidden" id="galleryImageUrl">
                    <img id="galleryPreview" class="cms-image-preview" alt="Preview">
                </div>
            </form>
        </div>
        <div class="cms-modal-footer">
            <button class="cms-btn cms-btn-secondary" onclick="closeGalleryModal()">Cancel</button>
            <button class="cms-btn cms-btn-primary" onclick="saveGalleryImage()">
                <i class="fas fa-save"></i> Save
            </button>
        </div>
    </div>
</div>

<script>
    function escapeHtml(str) {
        return String(str || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    async function loadGallery() {
        const grid = document.getElementById('galleryGrid');
        try {
            const response = await fetch('/api/cms/gallery');
            const images = await response.json();

            if (!images.length) {
                grid.innerHTML = '<div class="cms-empty-state"><i class="fas fa-images"></i><h3>No images yet</h3><p>Upload your first image to get started.</p></div>';
                return;
            }

            grid.innerHTML = images.map(img => `
                <div class="cms-gallery-item">
                    <img src="${escapeHtml(img.image_url)}" alt="${escapeHtml(img.alt_text)}">
                    <div class="cms-gallery-item-overlay">
                        <span class="cms-gallery-item-title">${escapeHtml(img.title)}</span>
                        <div class="cms-gallery-item-actions">
                            <button class="cms-btn cms-btn-secondary cms-btn-sm" onclick='editGalleryImage(${JSON.stringify(img)})'>
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="cms-btn cms-btn-danger cms-btn-sm" onclick="deleteGalleryImage('${img._id}')">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
        } catch (error) {
            console.error('Error loading gallery:', error);
            grid.innerHTML = '<div class="cms-empty-state"><i class="fas fa-exclamation-triangle"></i><h3>Failed to load gallery</h3></div>';
        }
    }

    function openUploadModal() {
        document.getElementById('galleryModalTitle').textContent = 'Upload Image';
        document.getElementById('galleryId').value = '';
        document.getElementById('galleryTitle').value = '';
        document.getElementById('galleryAlt').value = '';
        document.getElementById('galleryImageUrl').value = '';
        document.getElementById('galleryFile').value = '';
        document.getElementById('galleryPreview').classList.remove('show');
        document.getElementById('galleryModal').classList.add('show');
    }

    function editGalleryImage(img) {
        document.getElementById('galleryModalTitle').textContent = 'Edit Image';
        document.getElementById('galleryId').value = img._id;
        document.getElementById('galleryTitle').value = img.title || '';
        document.getElementById('galleryAlt').value = img.alt_text || '';
        document.getElementById('galleryImageUrl').value = img.image_url || '';
        document.getElementById('galleryFile').value = '';
        const preview = document.getElementById('galleryPreview');
        preview.src = img.image_url;
        preview.classList.add('show');
        document.getElementById('galleryModal').classList.add('show');
    }

    function closeGalleryModal() {
        document.getElementById('galleryModal').classList.remove('show');
    }

    async function previewGalleryImage(input) {
        const file = input.files[0];
        if (!file) return;
        try {
            showToast('Uploading image...');
            const url = await uploadImage(file);
            document.getElementById('galleryImageUrl').value = url;
            const preview = document.getElementById('galleryPreview');
            preview.src = url;
            preview.classList.add('show');
            showToast('Image uploaded! Click Save to finish.');
        } catch (error) {
            console.error('Error uploading image:', error);
            showToast(error.message || 'Error uploading image', 'error');
        }
    }

    async function saveGalleryImage() {
        const id = document.getElementById('galleryId').value;
        const title = document.getElementById('galleryTitle').value.trim();
        const imageUrl = document.getElementById('galleryImageUrl').value;

        if (!title) { showToast('Please enter a title', 'error'); return; }
        if (!imageUrl) { showToast('Please upload an image', 'error'); return; }

        const payload = {
            title: title,
            alt_text: document.getElementById('galleryAlt').value,
            image_url: imageUrl
        };

        try {
            const url = id ? `/api/cms/gallery/${id}` : '/api/cms/gallery';
            const method = id ? 'PUT' : 'POST';
            const response = await fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (response.ok) {
                showToast(id ? 'Image updated successfully!' : 'Image uploaded successfully!');
                closeGalleryModal();
                loadGallery();
            } else {
                showToast('Error saving image', 'error');
            }
        } catch (error) {
            console.error('Error saving image:', error);
            showToast('Error saving image', 'error');
        }
    }

    async function deleteGalleryImage(id) {
        if (!confirm('Are you sure you want to delete this image?')) return;
        try {
            const response = await fetch(`/api/cms/gallery/${id}`, { method: 'DELETE' });
            if (response.ok) {
                showToast('Image deleted successfully!');
                loadGallery();
            } else {
                showToast('Error deleting image', 'error');
            }
        } catch (error) {
            console.error('Error deleting image:', error);
            showToast('Error deleting image', 'error');
        }
    }

    document.addEventListener('DOMContentLoaded', loadGallery);
</script>

<%- include('cms-dashboard-end') %>
